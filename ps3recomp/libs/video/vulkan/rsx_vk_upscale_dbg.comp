#version 450
// ps3recomp Vulkan upscaler: debug visualization compute pass.
//   opt.y == 1 (mv):     motion vectors as RGB (R=dx/16+0.5, G=dy/16+0.5, B=|mv|/32)
//   opt.y == 2 (depth):  scene depth ((1 - z) * 200, sky = blue)
//   opt.y == 3 (warp):   |this frame - prev frame warped by mv| * 4
//   opt.y == 4 (nowarp): |this frame - prev frame without mv| * 4
//   opt.y == 5 (zcheck): green=camera fits, cyan=zero-motion, red=moving, orange=disoccluded, blue=sky
//   opt.y == 6 (hud):    HUD-diff mask (magenta = HUD pixels, dimmed grayscale = pre-HUD scene)
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform K {
    vec4 ic0, ic1, ic2, ic3;
    vec4 pv0, pv1, pv2, pv3;
    vec4 dims;
    vec4 opt;
    vec4 outd;
};

layout(set = 0, binding = 2, rg16f) uniform readonly image2D mv;
layout(set = 0, binding = 3, r32f)  uniform readonly image2D dz;
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D o;
layout(set = 0, binding = 5) uniform sampler2D sc;
layout(set = 0, binding = 6) uniform sampler2D hu;
layout(set = 0, binding = 7) uniform sampler2D pr;
layout(set = 0, binding = 8) uniform sampler2D pz;

vec2 zerr(vec2 pos, float zq)
{
    if (pos.x < 0.0 || pos.y < 0.0 || pos.x >= dims.x || pos.y >= dims.y)
        return vec2(-1.0, 0.0);
    ivec2 i = ivec2(floor(pos - 0.5));
    ivec2 mx = ivec2(dims.xy) - ivec2(1);
    vec2 b = vec2(1e9, 0.0);
    for (int k = 0; k < 4; k++) {
        ivec2 t = clamp(i + ivec2(k & 1, k >> 1), ivec2(0), mx);
        float zp = texelFetch(pz, t, 0).r;
        float s = (zq - zp) / max(1.0 - zp, 1e-7);
        if (abs(s) < b.x) b = vec2(abs(s), s);
    }
    return b;
}

vec4 reproj(uvec2 id, float z)
{
    vec2 pc = (vec2(id) + 0.5) - dims.zw;
    vec4 p = vec4(pc.x / dims.x * 2.0 - 1.0, 1.0 - pc.y / dims.y * 2.0, z, 1.0);
    vec4 w = vec4(dot(ic0, p), dot(ic1, p), dot(ic2, p), dot(ic3, p));
    vec4 q = vec4(dot(pv0, w), dot(pv1, w), dot(pv2, w), dot(pv3, w));
    if (q.w <= 1e-6) return vec4(0.0, 0.0, z, 0.0);
    vec2 n = q.xy / q.w;
    return vec4(vec2((n.x * 0.5 + 0.5) * dims.x, (0.5 - n.y * 0.5) * dims.y) - pc, q.z / q.w, 1.0);
}

vec3 pick(uvec2 id, float z)
{
    vec4 r = reproj(id, z);
    if (r.w == 0.0) return vec3(0.0, 0.0, 2.0);
    if (z >= 1.0 || opt.x < 1.5) return vec3(r.xy, 0.0);
    vec2 pc = (vec2(id) + 0.5) - dims.zw;
    vec2 ec = zerr(pc + r.xy + opt.zw, r.z);
    if (ec.x < 0.02) return vec3(r.xy, 0.0);
    if (ec.y > 0.0) return vec3(r.xy, 3.0);
    vec2 e0 = zerr(pc + opt.zw, z);
    if (e0.x >= 0.0 && e0.x < 0.005 && e0.x * 4.0 < ec.x) return vec3(0.0, 0.0, 1.0);
    return vec3(r.xy, 2.0);
}

vec4 ld(ivec2 i)
{
    return texelFetch(pr, clamp(i, ivec2(0), ivec2(dims.xy) - ivec2(1)), 0);
}

void main()
{
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= uint(outd.x) || id.y >= uint(outd.y)) return;
    uvec2 r = min(uvec2(vec2(id) * dims.xy / outd.xy), uvec2(dims.xy) - uvec2(1));
    ivec2 ri = ivec2(r);

    if (opt.y > 5.5) {
        vec3 s = texelFetch(sc, ri, 0).rgb;
        vec3 h = texelFetch(hu, ri, 0).rgb;
        bool is_hud = any(greaterThan(abs(s - h), vec3(0.5 / 255.0)));
        float lum = dot(s, vec3(0.3, 0.5, 0.2));
        vec3 c = is_hud ? vec3(1.0, 0.15, 0.85) : vec3(lum * 0.45);
        imageStore(o, ivec2(id), vec4(c, 1.0));
        return;
    }
    if (opt.y > 4.5) {
        float z = imageLoad(dz, ri).r;
        if (z >= 1.0) { imageStore(o, ivec2(id), vec4(0.0, 0.0, 0.4, 1.0)); return; }
        vec3 cols[4] = vec3[4](vec3(0.0, 1.0, 0.0), vec3(0.0, 0.8, 1.0), vec3(1.0, 0.0, 0.0), vec3(1.0, 0.6, 0.0));
        vec3 c = (opt.x > 0.5) ? cols[int(pick(r, z).z)] : vec3(1.0, 0.0, 1.0);
        float lum = dot(texelFetch(sc, ri, 0).rgb, vec3(0.3, 0.5, 0.2));
        imageStore(o, ivec2(id), vec4(c * (0.35 + 0.65 * lum), 1.0));
        return;
    }
    if (opt.y > 2.5) {
        vec2 m = (opt.y > 3.5) ? vec2(0.0) : imageLoad(mv, ri).xy;
        vec2 q = vec2(r) + m - dims.zw + opt.zw;
        ivec2 i = ivec2(floor(q));
        vec2 f = q - floor(q);
        vec4 p = mix(mix(ld(i), ld(i + ivec2(1, 0)), f.x),
                     mix(ld(i + ivec2(0, 1)), ld(i + ivec2(1, 1)), f.x), f.y);
        vec3 err = clamp(abs(texelFetch(sc, ri, 0).rgb - p.rgb) * 4.0, 0.0, 1.0);
        imageStore(o, ivec2(id), vec4(err, 1.0));
        return;
    }
    if (opt.y > 1.5) {
        float z = imageLoad(dz, ri).r;
        float v = clamp((1.0 - z) * 200.0, 0.0, 1.0);
        imageStore(o, ivec2(id), vec4(v, v, z >= 1.0 ? 1.0 : v, 1.0));
        return;
    }
    vec2 m = imageLoad(mv, ri).xy;
    imageStore(o, ivec2(id), vec4(clamp(0.5 + m.x / 16.0, 0.0, 1.0),
                                  clamp(0.5 + m.y / 16.0, 0.0, 1.0),
                                  clamp(length(m) / 32.0, 0.0, 1.0), 1.0));
}
