#version 450
// ps3recomp Vulkan upscaler: HUD-merge compute pass.
// Wherever the finished frame (hu) differs from the pre-HUD scene (sc),
// blends those HUD pixels over the upscaled output (o). Exact per-pixel
// replace at 1:1, smooth 2x2 bilinear enlargement when upscaling.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform K {
    vec4 ic0, ic1, ic2, ic3;
    vec4 pv0, pv1, pv2, pv3;
    vec4 dims;
    vec4 opt;
    vec4 outd;
};

layout(set = 0, binding = 4, rgba8) uniform image2D o;
layout(set = 0, binding = 5) uniform sampler2D sc;
layout(set = 0, binding = 6) uniform sampler2D hu;

void main()
{
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= uint(outd.x) || id.y >= uint(outd.y)) return;
    vec2 p = (vec2(id) + 0.5) * dims.xy / outd.xy - 0.5;
    ivec2 i = ivec2(floor(p));
    vec2 f = p - floor(p);
    ivec2 mx = ivec2(dims.xy) - ivec2(1);
    float a = 0.0;
    vec3 c = vec3(0.0);
    for (int k = 0; k < 4; k++) {
        ivec2 t = clamp(i + ivec2(k & 1, k >> 1), ivec2(0), mx);
        float wx = ((k & 1) != 0) ? f.x : (1.0 - f.x);
        float wy = ((k >> 1) != 0) ? f.y : (1.0 - f.y);
        float w = wx * wy;
        vec4 s = texelFetch(sc, t, 0);
        vec4 h = texelFetch(hu, t, 0);
        bvec3 diff = greaterThan(abs(s.rgb - h.rgb), vec3(0.5 / 255.0));
        if (any(diff)) a += w;
        c += w * h.rgb;
    }
    if (a > 0.0) {
        vec3 dst = imageLoad(o, ivec2(id)).rgb;
        vec3 res = (a >= 1.0) ? c : mix(dst, c, a);
        imageStore(o, ivec2(id), vec4(res, 1.0));
    }
}
