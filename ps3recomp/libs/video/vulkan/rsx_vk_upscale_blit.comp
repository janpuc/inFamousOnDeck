#version 450
// ps3recomp Vulkan upscaler: bilinear blit compute pass (render -> output).
// pc.use_sc == 0: enlarge hu (finished frame with HUD, menus/loading/videos).
// pc.use_sc == 1: enlarge sc (pre-HUD scene, Job 1 passthrough before FSR 3.1.5).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint use_sc;
} pc;

layout(set = 0, binding = 0) uniform K {
    vec4 ic0, ic1, ic2, ic3;
    vec4 pv0, pv1, pv2, pv3;
    vec4 dims;
    vec4 opt;
    vec4 outd;
};

layout(set = 0, binding = 4, rgba8) uniform writeonly image2D o;
layout(set = 0, binding = 5) uniform sampler2D sc;
layout(set = 0, binding = 6) uniform sampler2D hu;

void main()
{
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= uint(outd.x) || id.y >= uint(outd.y)) return;
    vec2 p = (vec2(id) + 0.5) * dims.xy / outd.xy - 0.5;
    ivec2 i = ivec2(floor(p));
    vec2 f = p - floor(p);
    ivec2 mx = ivec2(dims.xy) - ivec2(1);
    vec3 c = vec3(0.0);
    for (int k = 0; k < 4; k++) {
        ivec2 t = clamp(i + ivec2(k & 1, k >> 1), ivec2(0), mx);
        float wx = ((k & 1) != 0) ? f.x : (1.0 - f.x);
        float wy = ((k >> 1) != 0) ? f.y : (1.0 - f.y);
        vec3 px = (pc.use_sc != 0u) ? texelFetch(sc, t, 0).rgb : texelFetch(hu, t, 0).rgb;
        c += (wx * wy) * px;
    }
    imageStore(o, ivec2(id), vec4(c, 1.0));
}
